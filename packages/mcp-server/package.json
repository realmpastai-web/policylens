{
  "name": "@policylens/mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "stdio MCP server for PolicyLens policy checks.",
  "bin": {
    "policylens-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@policylens/core": "*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "esbuild": "^0.25.12",
    "vitest": "^3.2.4"
  }
}
